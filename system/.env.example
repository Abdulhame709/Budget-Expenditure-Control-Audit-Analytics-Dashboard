# Copy to .env for local development. Never commit the real .env file.
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://audit_user:audit_pass@127.0.0.1:5432/audit_budget_system
# Keep demo while the database contains synthetic records. Switch to
# operational only after exporting/removing demo data and demo accounts.
SYSTEM_MODE=demo

# ---------------------------------------------------------------- staging / production
# Configure these only in the hosting provider's secret/environment store.
# Use exact hostnames, a TLS-enabled PostgreSQL runtime URL and a separate
# least-privileged migration URL. Do not copy demo credentials to production.
# DJANGO_ENV=staging
# DJANGO_SETTINGS_MODULE=config.settings.staging
# DJANGO_SECRET_KEY=<random secret, 50+ characters>
# DJANGO_ALLOWED_HOSTS=staging.audit.example.org
# DATABASE_URL=postgresql://runtime_user:<secret>@db.example.org/audit_budget_system
# MIGRATION_DATABASE_URL=postgresql://migration_user:<secret>@db.example.org/audit_budget_system
# DJANGO_READINESS_TOKEN=<generated health-check secret>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.audit.example.org
# SYSTEM_MODE=operational
# DJANGO_ALLOW_SYNTHETIC_DATASET=true  # staging only, isolated training DB only
# DJANGO_SECURE_SSL_REDIRECT=true
# Keep HSTS at 0 until the real domain, TLS proxy and redirect are verified.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
#
# Production uses the same variables with DJANGO_ENV=production and
# DJANGO_SETTINGS_MODULE=config.settings.production. Synthetic data loading is
# always rejected in production, even if DJANGO_ALLOW_SYNTHETIC_DATASET is set.
# For one-off migrations only, set DJANGO_USE_MIGRATION_DATABASE=true for that
# release command; web processes must continue using DATABASE_URL.
# For Supabase, keep the connection string in the hosting secret store. Prefer
# Supavisor session mode for an IPv4 Django runtime and a direct TLS connection
# for migrations/backups. Never put database passwords or service-role keys in
# frontend code or Git.
