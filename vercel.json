{
  "version": 2,
  "name": "budget-audit-analytics",
  "buildCommand": "pip install -r system/requirements.txt && python system/manage.py collectstatic --noinput",
  "outputDirectory": "system/staticfiles",
  "installCommand": "pip install -r system/requirements.txt",
  "functions": {
    "system/vercel_wsgi.py": {
      "runtime": "python3.11",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/media/(.*)", "dest": "/media/$1" },
    { "src": "/(.*)", "dest": "system/vercel_wsgi.py" }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.production",
    "DJANGO_ENV": "production"
  }
}
