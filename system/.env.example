# Copy to .env and adjust. Never commit .env (ignored via .gitignore).
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://audit_user:audit_pass@127.0.0.1:5432/audit_budget_system

# ---------------------------------------------------------------- production
# Used only with DJANGO_SETTINGS_MODULE=config.settings.production
# (DEBUG is ALWAYS False there; SECRET_KEY + ALLOWED_HOSTS are mandatory).
# DJANGO_ALLOWED_HOSTS=audit.example.org,www.audit.example.org
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://audit.example.org
